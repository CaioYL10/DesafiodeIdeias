{
  "name": "desafio-de-ideias-feedback-mvp",
  "version": "1.0.0",
  "private": true,
  "description": "MVP local para registrar e analisar feedbacks demonstrativos de serviços da CTI",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "demo": "node scripts/start-demo.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "manager:create": "node --env-file-if-exists=.env scripts/create-manager.js",
    "test": "node --test"
  },
  "dependencies": {
    "docx": "^9.7.2",
    "express": "^5.3.0"
  }
}
